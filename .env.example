# Copie para .env e preencha com os dados do app novo (não é o app do ml-jrf)
ML_APP_ID=
ML_SECRET_KEY=
# Exatamente como está cadastrada no app do ML
ML_REDIRECT_URI=
# 1 só se o PKCE estiver ligado na configuração do app
ML_PKCE=0
# Limite de requisições por segundo desta ferramenta
ML_MAX_RPS=4
# Margem alvo sobre o preço de venda, usada no preco_sugerido do custo.py (0.18 = 18%)
MARGEM_META=0.18
# Margem alvo do preço de atacado, nas colunas *_atacado do custo.py (0.175 = 17,5%)
MARGEM_META_ATACADO=0.175
